# Repo-level, machine-specific ignores. Project-specific rules live in each
# project's own .gitignore (e.g. AtomV1/.gitignore).

# Python bytecode
__pycache__/
*.py[cod]

# Virtual environments
.venv/
env/
venv/
ENV/

# IDE/editor files
.vscode/
.idea/
*.swp
*~

# OS generated files
Thumbs.db
desktop.ini
.DS_Store

# Local tooling indexes (generated, machine-specific)
.vexp/
