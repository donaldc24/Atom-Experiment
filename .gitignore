# Optional: ignore generated distribution directories
pip-wheel-metadata/

# E1: checkpoints are large and regenerable from config + seed; every metric is
# derivable from the artifacts, which ARE tracked. splits/ is frozen and tracked.
# Must be `**`, not `*`: runs are nested one level deeper from D40 on
# (runs/<generation>/<run_id>/checkpoints) and archived runs deeper still, so a
# single-level pattern would silently start committing every checkpoint.
runs/**/checkpoints/


# Local tooling indexes (generated, machine-specific)
.vexp/
